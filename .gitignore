# .NET build artifacts (generated by C# Dev Kit / dotnet CLI from test fixture .csproj files)
*.sln
**/bin/
**/obj/

# Keep test fixture obj/ directory (needed by integration tests)
!src/test/fixtures/obj/
!src/test/fixtures/obj/**
# Restore output that the 2.0 project fixtures track on purpose (plan item P2.2)
!src/core/project/__fixtures__/**/obj/

# Dependencies
node_modules/

# Build output
out/
dist/

# Packaged extension
*.vsix

# VS Code test folder
.vscode-test/

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed

# IDE/Editor settings (already tracked in .vscode for this project)
# .vscode/
.vscode/settings.json

# TypeScript cache
*.tsbuildinfo

# Optional npm cache
.npm

# Test coverage
.nyc_output/
coverage/

# Benchmark ephemeral output (baseline.json is committed)
benchmarks/latest.json

# Contract-change sentinel for the 2.0 plan (D6): exists only while an approved contract edit is in progress
.claude/.contract-change
# Test-retirement sentinel of the UX plan (D29): exists only while an item retires the test paths it lists
.claude/.test-retire
# CI captures downloaded by a session (RUN-ux.md §4): cited by run id and sha256, never committed
captures/

# Environment files
.env
.env.local
.env.*.local

# Alternative package manager lock files (using npm)
yarn.lock
pnpm-lock.yaml

# Screenshots and temp files (but not resources/icons or docs/images)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
!resources/*.png
!docs/images/*.gif
!docs/images/*.png
# UX plan: committed artboard renders, goldens, probe evidence and the Marketplace captures
!docs/design/**/*.png
!src/test/ui/v2/golden/**/*.png
!resources/readme/*.png
!resources/readme/*.gif
!docs/ux/reference-2.0/*.png

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
