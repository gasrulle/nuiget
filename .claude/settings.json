{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run bench)",
      "Bash(npm run bench:*)",
      "Bash(npm run lint)",
      "Bash(npm run check-types)",
      "Bash(npm run compile)",
      "Bash(npm run package)",
      "Bash(npm run package:vsix)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(node esbuild.mjs:*)",
      "Bash(xvfb-run -a npm run test:*)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet --version)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-remote:*)",
      "Bash(gh run:*)",
      "Bash(gh pr view:*)",
      "Bash(gh workflow view:*)",
      "Bash(npm ci)",
      "Bash(npm run check:vsix)",
      "Bash(npm run docs:protocol)",
      "Bash(npm run docs:protocol:check)",
      "Bash(npm run docs:check)",
      "Bash(node scripts/*)",
      "Bash(node esbuild.mjs --v2*)",
      "Bash(npm run watch:v2)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(node --test:*)",
      "Bash(npx vsce ls)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(dotnet msbuild:*)",
      "Bash(dotnet nuget:*)",
      "Bash(dotnet package:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git pull --ff-only)",
      "Bash(git merge --no-edit origin/main)",
      "Bash(git tag:*)",
      "Bash(git push -u origin labs/*)",
      "Bash(git push origin labs/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr ready:*)",
      "Bash(node scripts/perf-baseline.mjs:*)",
      "Bash(npm run perf:baseline:*)",
      "Bash(node scripts/probe-sdk.mjs:*)"
    ],
    "ask": [
      "Bash(npm version:*)"
    ],
    "deny": [
      "Bash(npx vsce publish:*)",
      "Bash(vsce publish:*)",
      "Bash(npx ovsx publish:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin main)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
