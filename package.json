{
    "name": "nuiget",
    "displayName": "nUIget - A NuGet Package Manager",
    "description": "A NuGet package manager with Visual Studio-style UI. Search, install, update, and remove packages across multiple sources.",
    "version": "1.18.5",
    "publisher": "Gasrulle",
    "license": "MIT",
    "icon": "resources/icon.png",
    "galleryBanner": {
        "color": "#512BD4",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gasrulle/nuiget"
    },
    "homepage": "https://github.com/gasrulle/nuiget#readme",
    "bugs": {
        "url": "https://github.com/gasrulle/nuiget/issues"
    },
    "engines": {
        "node": ">=22",
        "vscode": "^1.85.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": false,
            "description": "This extension executes dotnet CLI commands and accesses the file system, which requires a trusted workspace."
        }
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "nuget",
        "package manager",
        "package management",
        "nuget packages",
        "dotnet packages",
        "manage nuget",
        "packages",
        "dependencies",
        "nuget.config",
        "azure devops",
        "dotnet",
        ".NET",
        "C#",
        "csharp"
    ],
    "activationEvents": [
        "workspaceContains:**/*.csproj",
        "workspaceContains:**/*.fsproj",
        "workspaceContains:**/*.vbproj"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "nuiget-sidebar",
                    "title": "nUIget",
                    "icon": "resources/sidebar-icon.svg"
                }
            ]
        },
        "views": {
            "nuiget-sidebar": [
                {
                    "type": "webview",
                    "id": "nuiget.sidebarView",
                    "name": "",
                    "when": "nuiget.hasProjectFiles"
                }
            ]
        },
        "commands": [
            {
                "command": "nuiget.openManager",
                "title": "nUIget: Manage NuGet Packages",
                "shortTitle": "nUIget: Manage Packages",
                "icon": "$(package)"
            },
            {
                "command": "nuiget.refreshPackages",
                "title": "nUIget: Refresh Packages",
                "icon": "$(refresh)"
            },
            {
                "command": "nuiget.sidebar.selectSource",
                "title": "nUIget: Select Package Source",
                "icon": "$(remote)"
            },
            {
                "command": "nuiget.sidebar.selectProject",
                "title": "nUIget: Select Project",
                "icon": "$(project)"
            },
            {
                "command": "nuiget.sidebar.togglePrerelease",
                "title": "nUIget: Include Pre-release",
                "icon": "$(beaker)"
            },
            {
                "command": "nuiget.sidebar.togglePrereleaseOff",
                "title": "nUIget: Exclude Pre-release",
                "icon": {
                    "dark": "resources/beaker-filled.svg",
                    "light": "resources/beaker-filled-light.svg"
                }
            },
            {
                "command": "nuiget.sidebar.refresh",
                "title": "nUIget: Refresh Sidebar",
                "icon": "$(refresh)"
            },
            {
                "command": "nuiget.sidebar.openFullView",
                "title": "nUIget: Open Full Manager",
                "icon": "$(link-external)"
            },
            {
                "command": "nuiget.clearHttpCache",
                "title": "nUIget: Clear NuGet HTTP Cache"
            },
            {
                "command": "nuiget.clearSdkVersionCache",
                "title": "nUIget: Clear SDK Version Cache"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "nuiget.refreshPackages",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.selectSource",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.selectProject",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.togglePrerelease",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.togglePrereleaseOff",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.openFullView",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.refresh",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "command": "nuiget.openManager",
                    "when": "resourceFilename =~ /\\.(csproj|fsproj|vbproj)$/",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "nuiget.openManager",
                    "when": "view == solutionExplorer && viewItem == Project",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "nuiget.openManager",
                    "when": "resourceFilename =~ /\\.(csproj|fsproj|vbproj)$/",
                    "group": "navigation"
                }
            ],
            "view/title": [
                {
                    "command": "nuiget.sidebar.togglePrerelease",
                    "when": "view == nuiget.sidebarView && !nuiget.prereleaseEnabled",
                    "group": "navigation@1"
                },
                {
                    "command": "nuiget.sidebar.togglePrereleaseOff",
                    "when": "view == nuiget.sidebarView && nuiget.prereleaseEnabled",
                    "group": "navigation@1"
                },
                {
                    "command": "nuiget.sidebar.selectProject",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@2"
                },
                {
                    "command": "nuiget.sidebar.selectSource",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@3"
                },
                {
                    "command": "nuiget.sidebar.refresh",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@4"
                },
                {
                    "command": "nuiget.sidebar.openFullView",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@5"
                }
            ]
        },
        "configuration": {
            "title": "nUIget",
            "properties": {
                "nuiget.noRestore": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip restore after adding packages. Faster but skips compatibility check until next build."
                },
                "nuiget.quickSearchResultsPerSource": {
                    "type": "integer",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Number of suggestions to show per source in quick search mode."
                },
                "nuiget.searchDebounceMode": {
                    "type": "string",
                    "enum": [
                        "quicksearch",
                        "full",
                        "off"
                    ],
                    "default": "quicksearch",
                    "enumDescriptions": [
                        "Show quick search suggestions as you type (fast, lightweight)",
                        "Perform full search as you type (slower, shows full results)",
                        "No automatic search while typing (only on Enter or button click)"
                    ],
                    "description": "Controls what happens when typing in the search box after a short delay."
                },
                "nuiget.recentSearchesLimit": {
                    "type": "integer",
                    "default": 5,
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Maximum number of recent searches to remember. Set to 0 to disable search history."
                },
                "nuiget.searchResultLimit": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Maximum number of packages to return from full search (dotnet CLI)."
                },
                "nuiget.enablePerformanceLogging": {
                    "type": "boolean",
                    "default": false,
                    "description": "Emit [perf] timing lines to the nUIget output channel for hot user-perceived flows (panel open, project switch, install/update/remove, search, update check). Use to diagnose slow operations or compare branches; keep off in normal use."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.mjs",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.mjs --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
        "check-types": "tsc --noEmit",
        "package:vsix": "npm install && npm run check-types && npm test && npm run package && node -e \"const v=require('./package.json').version;require('child_process').execSync('npx vsce package --out nuiget-v'+v+'.vsix',{stdio:'inherit'})\"",
        "lint": "eslint src",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:backend": "vitest run --project backend",
        "test:frontend": "vitest run --project frontend",
        "test:integration": "vitest run --project integration",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "tsc -p tsconfig.test.json && vscode-test",
        "test:ui": "tsc -p tsconfig.test.json && npm run package:vsix && extest setup-and-run out/test/ui/*.ui.test.js --code_version max --code_settings src/test/ui/settings.json --open_resource src/test/e2e/fixtures/e2e-workspace",
        "bench": "vitest bench --run --project backend",
        "bench:save": "vitest bench --run --project backend --outputJson benchmarks/baseline.json",
        "bench:compare": "vitest bench --run --project backend --compare benchmarks/baseline.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/adm-zip": "^0.5.7",
        "@types/dompurify": "^3.0.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.5.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/vscode": "^1.85.0",
        "@vitest/coverage-v8": "^4.1.2",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.9.1",
        "chai": "^6.2.2",
        "esbuild": "^0.27.2",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.3.0",
        "jsdom": "^29.0.1",
        "mocha": "^11.7.5",
        "msw": "^2.12.14",
        "npm-run-all": "^4.1.5",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.2",
        "vscode-extension-tester": "^8.23.0"
    },
    "dependencies": {
        "@tanstack/react-virtual": "^3.13.18",
        "adm-zip": "^0.5.16",
        "dompurify": "^3.3.1",
        "fast-xml-parser": "^5.3.4",
        "highlight.js": "^11.11.1",
        "marked": "^17.0.1",
        "marked-highlight": "^2.2.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "overrides": {
        "diff": "^8.0.3",
        "serialize-javascript": "^7.0.5",
        "eslint-plugin-react-hooks": {
            "eslint": "$eslint"
        }
    }
}
