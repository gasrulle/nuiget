{
    "name": "nuiget",
    "displayName": "nUIget - A NuGet Package Manager",
    "description": "A NuGet package manager with Visual Studio-style UI. Search, install, update, and remove packages across multiple sources.",
    "version": "2.0.0",
    "publisher": "Gasrulle",
    "license": "MIT",
    "icon": "resources/icon.png",
    "galleryBanner": {
        "color": "#512BD4",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gasrulle/nuiget"
    },
    "homepage": "https://github.com/gasrulle/nuiget#readme",
    "bugs": {
        "url": "https://github.com/gasrulle/nuiget/issues"
    },
    "engines": {
        "node": ">=22",
        "vscode": "^1.90.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": false,
            "description": "This extension executes dotnet CLI commands and accesses the file system, which requires a trusted workspace."
        }
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "nuget",
        "package manager",
        "package management",
        "nuget packages",
        "dotnet packages",
        "manage nuget",
        "packages",
        "dependencies",
        "nuget.config",
        "azure devops",
        "dotnet",
        ".NET",
        "C#",
        "csharp"
    ],
    "activationEvents": [
        "workspaceContains:**/*.csproj",
        "workspaceContains:**/*.fsproj",
        "workspaceContains:**/*.vbproj"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "nuiget-sidebar",
                    "title": "nUIget",
                    "icon": "resources/sidebar-icon.svg"
                }
            ]
        },
        "views": {
            "nuiget-sidebar": [
                {
                    "type": "webview",
                    "id": "nuiget.sidebarView",
                    "name": "",
                    "when": "nuiget.hasProjectFiles"
                }
            ]
        },
        "commands": [
            {
                "command": "nuiget.openManager",
                "title": "nUIget: Manage NuGet Packages",
                "shortTitle": "nUIget: Manage Packages",
                "icon": "$(package)"
            },
            {
                "command": "nuiget.refreshPackages",
                "title": "nUIget: Refresh Packages",
                "icon": "$(refresh)"
            },
            {
                "command": "nuiget.sidebar.selectSource",
                "title": "nUIget: Select Package Source",
                "icon": "$(remote)"
            },
            {
                "command": "nuiget.sidebar.selectProject",
                "title": "nUIget: Select Project",
                "icon": "$(project)"
            },
            {
                "command": "nuiget.sidebar.togglePrerelease",
                "title": "nUIget: Include Pre-release",
                "icon": "$(beaker)"
            },
            {
                "command": "nuiget.sidebar.togglePrereleaseOff",
                "title": "nUIget: Exclude Pre-release",
                "icon": {
                    "dark": "resources/beaker-filled.svg",
                    "light": "resources/beaker-filled-light.svg"
                }
            },
            {
                "command": "nuiget.sidebar.toggleRestore",
                "title": "nUIget: Restore after operations",
                "icon": "$(verified)"
            },
            {
                "command": "nuiget.sidebar.toggleRestoreOff",
                "title": "nUIget: Skip restore after operations",
                "icon": "$(verified-filled)"
            },
            {
                "command": "nuiget.sidebar.refresh",
                "title": "nUIget: Refresh Sidebar",
                "icon": "$(refresh)"
            },
            {
                "command": "nuiget.sidebar.openFullView",
                "title": "nUIget: Open Full Manager",
                "icon": "$(link-external)"
            },
            {
                "command": "nuiget.clearHttpCache",
                "title": "nUIget: Clear NuGet HTTP Cache"
            },
            {
                "command": "nuiget.clearSdkVersionCache",
                "title": "nUIget: Clear SDK Version Cache"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "nuiget.refreshPackages",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.selectSource",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.selectProject",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.togglePrerelease",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.togglePrereleaseOff",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.toggleRestore",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.toggleRestoreOff",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.openFullView",
                    "when": "false"
                },
                {
                    "command": "nuiget.sidebar.refresh",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "command": "nuiget.openManager",
                    "when": "resourceFilename =~ /\\.(csproj|fsproj|vbproj)$/",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "nuiget.openManager",
                    "when": "view == solutionExplorer && viewItem == Project",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "nuiget.openManager",
                    "when": "resourceFilename =~ /\\.(csproj|fsproj|vbproj)$/",
                    "group": "navigation"
                }
            ],
            "view/title": [
                {
                    "command": "nuiget.sidebar.togglePrerelease",
                    "when": "view == nuiget.sidebarView && !nuiget.prereleaseEnabled",
                    "group": "navigation@1"
                },
                {
                    "command": "nuiget.sidebar.togglePrereleaseOff",
                    "when": "view == nuiget.sidebarView && nuiget.prereleaseEnabled",
                    "group": "navigation@1"
                },
                {
                    "command": "nuiget.sidebar.toggleRestore",
                    "when": "view == nuiget.sidebarView && !nuiget.restoreEnabled",
                    "group": "navigation@0"
                },
                {
                    "command": "nuiget.sidebar.toggleRestoreOff",
                    "when": "view == nuiget.sidebarView && nuiget.restoreEnabled",
                    "group": "navigation@0"
                },
                {
                    "command": "nuiget.sidebar.selectProject",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@2"
                },
                {
                    "command": "nuiget.sidebar.selectSource",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@3"
                },
                {
                    "command": "nuiget.sidebar.refresh",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@4"
                },
                {
                    "command": "nuiget.sidebar.openFullView",
                    "when": "view == nuiget.sidebarView",
                    "group": "navigation@5"
                }
            ]
        },
        "configuration": {
            "title": "nUIget",
            "properties": {
                "nuiget.quickSearchResultsPerSource": {
                    "type": "integer",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Number of suggestions to show per source in quick search mode."
                },
                "nuiget.searchDebounceMode": {
                    "type": "string",
                    "enum": [
                        "quicksearch",
                        "full",
                        "off"
                    ],
                    "default": "quicksearch",
                    "enumDescriptions": [
                        "Show quick search suggestions as you type (fast, lightweight)",
                        "Main panel: perform the full search as you type (slower, shows full results)",
                        "Main panel: no automatic search while typing; Enter searches"
                    ],
                    "description": "Controls what typing in the main panel's search box does after a short delay. The sidebar searches as you type in every mode."
                },
                "nuiget.searchResultLimit": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Maximum number of packages to return from full search (dotnet CLI)."
                },
                "nuiget.enablePerformanceLogging": {
                    "type": "boolean",
                    "default": false,
                    "description": "Writes the webviews' [perf] marks (webview ready, first useful render) to the nUIget output channel at Info level instead of Debug. The duration of every dotnet command is always logged. Keep it off in normal use."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.mjs",
        "watch": "npm-run-all -p watch:esbuild watch:tsc",
        "watch:esbuild": "node esbuild.mjs --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
        "check-types": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.vitest.json",
        "check:vsix": "node scripts/check-vsix-contents.mjs",
        "docs:protocol": "node scripts/gen-protocol-docs.mjs",
        "docs:protocol:check": "node scripts/gen-protocol-docs.mjs --check",
        "docs:check": "node scripts/check-docs-drift.mjs && npm run docs:protocol:check",
        "check:matrix": "node scripts/check-regression-matrix.mjs",
        "perf:baseline": "node scripts/perf-baseline.mjs",
        "package:vsix": "npm ci --no-audit --no-fund && npm run check-types && npm test && npm run package && node -e \"const v=require('./package.json').version;require('child_process').execSync('npx vsce package --out nuiget-v'+v+'.vsix',{stdio:'inherit'})\"",
        "lint": "eslint src scripts esbuild.mjs eslint.config.mjs vitest.config.mts .vscode-test.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:backend": "vitest run --project backend",
        "test:frontend": "vitest run --project frontend",
        "test:integration": "vitest run --project integration",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "tsc -p tsconfig.test.json && vscode-test",
        "test:ui": "tsc -p tsconfig.test.json && extest setup-and-run out/test/ui/v2/*.ui.test.js --code_version max --code_settings src/test/ui/settings.json --open_resource src/test/e2e/fixtures/e2e-workspace",
        "bench": "node src/test/benchmarks/run.mjs run",
        "bench:save": "node src/test/benchmarks/run.mjs save",
        "bench:compare": "node src/test/benchmarks/run.mjs compare"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types-host/node": "npm:@types/node@20.19.43",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/vscode": "1.90.0",
        "@vitest/coverage-v8": "^5.0.5",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "chai": "^6.3.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "jest-axe": "^11.0.0",
        "mocha": "^12.0.3",
        "msw": "^2.15.0",
        "npm-run-all2": "^9.0.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.3",
        "vscode-extension-tester": "^8.28.1"
    },
    "dependencies": {
        "@tanstack/react-virtual": "^3.14.21",
        "adm-zip": "^0.6.1",
        "dompurify": "^3.4.17",
        "fast-xml-parser": "^5.11.2",
        "highlight.js": "^11.12.0",
        "marked": "^18.1.1",
        "marked-highlight": "^2.2.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
