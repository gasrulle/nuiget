{
  "state": "main-details-readonly",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet Packages\"",
    "  checkbox \"Restore After Operations\" [checked]",
    "  checkbox \"Include Pre-Release\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Empty.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unresolved.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All Sources\"",
    "    option \"nuget.org\"",
    "  button \"Manage Package Sources...\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed\" [selected] {installed-tab}",
    "    tab \"Updates #\" {updates-tab}",
    "  tabpanel \"Installed\"",
    "    toolbar \"Bulk actions\" {installed-toolbar}",
    "      button \"Select All\" [disabled, not pressed] {select-all-button}",
    "      button \"Uninstall Selected (#)\" [disabled] {uninstall-selected-button}",
    "    progressbar \"Loading installed packages\" {installed-progress}",
    "    group \"Installed packages\" [focused]",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "    heading \"Serilog\"",
    "    status \"\" {details-readonly}",
    "    combobox \"Version\" {version-selector}",
    "      option \"#\"",
    "    button \"Install\" [disabled] {install-update-button}",
    "    tablist \"Details sections\" {details-tab-bar}",
    "      tab \"Details\" [selected] {details-tab-details}",
    "      tab \"README\" {details-tab-readme}",
    "    tabpanel \"Details\"",
    "      term \"Version\"",
    "      definition \"\"",
    "      term \"Authors\"",
    "      definition \"\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      term \"License\"",
    "      definition \"\"",
    "        link \"Apache-#\"",
    "      term \"Package size\"",
    "      definition \"\"",
    "      term \"Date published\"",
    "      definition \"\"",
    "      term \"Project URL\"",
    "      definition \"\"",
    "        link \"https://serilog.net/\"",
    "      term \"Report abuse\"",
    "      definition \"\"",
    "        link \"Report this package\"",
    "      region \"Dependencies\"",
    "        heading \"Dependencies\"",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \"net# #\"",
    "          button \"net# #\" [collapsed] {section-header-dependencies-net#}",
    "        heading \"net# #\"",
    "          button \"net# #\" [collapsed] {section-header-dependencies-net#}",
    "        heading \"net# #\"",
    "          button \"net# #\" [collapsed] {section-header-dependencies-net#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "  status \"\" {status-live}"
  ]
}
