{
  "state": "main-consolidate-dialog",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet Packages\"",
    "  checkbox \"Restore After Operations\" [checked]",
    "  checkbox \"Include Pre-Release\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Empty.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unresolved.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All Sources\"",
    "    option \"nuget.org\"",
    "  button \"Manage Package Sources...\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed # # packages with known vulnerabilities\" {installed-tab}",
    "    tab \"Updates #\" {updates-tab}",
    "    tab \"Consolidate #\" [selected] {consolidate-tab}",
    "  tabpanel \"Consolidate #\"",
    "    status \"\" {consolidate-incomplete-banner}",
    "    listbox \"Packages at different versions\" {consolidate-list}",
    "      option \"Newtonsoft.Json # versions in # projects\" [selected]",
    "      option \"Serilog # versions in # projects\"",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "    heading \"Newtonsoft.Json\"",
    "    combobox \"Version\" {version-selector}",
    "      option \"#\"",
    "      option \"# (in use)\"",
    "      option \"#\"",
    "      option \"# (vulnerable)\"",
    "      option \"# (in use, vulnerable)\"",
    "      option \"# (vulnerable)\"",
    "    button \"Consolidate...\" {consolidate-button}",
    "    tablist \"Details sections\" {details-tab-bar}",
    "      tab \"Details\" [selected] {details-tab-details}",
    "      tab \"README\" {details-tab-readme}",
    "    tabpanel \"Details\"",
    "      region \"Projects\" {consolidate-projects}",
    "        heading \"Projects\"",
    "        term \"Gateway.csproj\"",
    "        definition \"\"",
    "        term \"Unresolved.csproj\"",
    "        definition \"\"",
    "        term \"Utility.csproj\"",
    "        definition \"\"",
    "        heading \"Not Changed\"",
    "        term \"Catalog.csproj\"",
    "        definition \"\"",
    "      term \"Version\"",
    "      definition \"\"",
    "      term \"Authors\"",
    "      definition \"\"",
    "      term \"License\"",
    "      definition \"\"",
    "        link \"MIT\"",
    "      term \"Package size\"",
    "      definition \"\"",
    "      term \"Date published\"",
    "      definition \"\"",
    "      term \"Project URL\"",
    "      definition \"\"",
    "        link \"https://www.newtonsoft.com/json\"",
    "      term \"Report abuse\"",
    "      definition \"\"",
    "        link \"Report this package\"",
    "      region \"Dependencies\"",
    "        heading \"Dependencies\"",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "        heading \"net# #\"",
    "          button \"net# #\" [collapsed] {section-header-dependencies-net#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "  status \"\" {status-live}",
    "alertdialog \"Consolidate Newtonsoft.Json to #?\" {confirm-dialog}",
    "  heading \"Consolidate Newtonsoft.Json to #?\"",
    "  list \"\"",
    "    listitem \"Newtonsoft.Json # → #\"",
    "  list \"\"",
    "    listitem \"Newtonsoft.Json # → #\"",
    "  button \"Cancel\" [focused] {confirm-dialog-cancel}",
    "  button \"Consolidate\" {confirm-dialog-confirm}"
  ]
}
