{
  "state": "main-installed-all-vulnerable-unavailable",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet Packages\"",
    "  checkbox \"Restore After Operations\" [checked]",
    "  checkbox \"Include Pre-Release\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Empty.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unresolved.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All Sources\"",
    "    option \"nuget.org\"",
    "  button \"Manage Package Sources...\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed, focused] {search-input}",
    "    button \"Clear Search\"",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed # # packages with known vulnerabilities\" [selected] {installed-tab}",
    "    tab \"Updates #\" {updates-tab}",
    "    tab \"Consolidate #\" {consolidate-tab}",
    "  tabpanel \"Installed #\"",
    "    toolbar \"Bulk actions\" {installed-toolbar}",
    "      button \"Select All\" [not pressed] {select-all-button}",
    "      button \"Uninstall Selected (#)\" [disabled] {uninstall-selected-button}",
    "    status \"\" {installed-vulnerable-unavailable-banner}",
    "    status \"\" {transitive-restore-banner}",
    "      button \"Restore\"",
    "    tree \"Installed packages\" [multiselectable] {installed-list}",
    "      treeitem \"app\" [expanded, level 1]",
    "      treeitem \"Catalog.csproj # of #\" [expanded, level 2]",
    "      treeitem \"Gateway.csproj # of #\" [expanded, level 2]",
    "      treeitem \"Newtonsoft.Json #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"tools\" [expanded, level 1]",
    "      treeitem \"Empty.csproj # of #\" [expanded, level 2]",
    "      treeitem \"Unresolved.csproj # of #\" [expanded, level 2]",
    "      treeitem \"Unsupported.csproj requires .NET SDK # or newerVersions come from the project files; a full evaluation is pending. # of \" [expanded, level 2]",
    "      treeitem \"Unsupported project: requires .NET SDK # or newer.\" [level 3]",
    "      treeitem \"Utility.csproj # of #\" [expanded, level 2]",
    "      treeitem \"Transitive Packages # of #\" [expanded, level 1]",
    "      treeitem \"SQLitePCLRaw.lib.e_sqlite# #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "  status \"\" {status-live}"
  ]
}
