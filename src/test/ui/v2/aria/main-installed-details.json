    "      treeitem \"System.Text.Json #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Transitive packages\" [collapsed, level 1]",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "    heading \"Newtonsoft.Json\"",
    "    button \"Uninstall\" {uninstall-button}",
    "    combobox \"Version\" {version-selector}",
    "      option \"#\"",
    "      option \"# (installed)\"",
    "      option \"#\"",
    "    button \"Update\" [disabled] {install-update-button}",
    "    tablist \"Details sections\" {details-tab-bar}",
    "      tab \"Details\" [selected] {details-tab-details}",
    "      tab \"README\" {details-tab-readme}",
    "    tabpanel \"Details\"",
    "      term \"Version\"",
    "      definition \"\"",
    "      term \"Authors\"",
    "      definition \"\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      term \"License\"",
    "      definition \"\"",
    "        link \"MIT\"",
    "      term \"Package size\"",
    "      definition \"\"",
    "      term \"Date published\"",
    "      definition \"\"",
    "      term \"Project URL\"",
    "      definition \"\"",
    "        link \"https://www.newtonsoft.com/json\"",
    "      term \"Report abuse\"",
    "      definition \"\"",
    "        link \"Report this package\"",
    "      region \"Vulnerabilities\"",
