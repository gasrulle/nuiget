    "      treeitem \"Microsoft.Extensions.Configuration.EnvironmentVariables #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.DependencyInjection.Abstractions #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Http #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Logging.Abstractions #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Options.ConfigurationExtensions #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"NETStandard.Library #\" [level 2]",
