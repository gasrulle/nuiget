    "          button \".NETPortable#-Profile# #\" [collapsed] {section-header-dependencies-.netportable#-profile#}",
    "        heading \".NETPortable#-Profile# #\"",
    "          button \".NETPortable#-Profile# #\" [collapsed] {section-header-dependencies-.netportable#-profile#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
