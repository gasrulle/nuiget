{
  "state": "main-updates",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet packages\"",
    "  checkbox \"Restore after operations\" [checked]",
    "  checkbox \"Include prerelease\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All sources\"",
    "    option \"nuget.org\"",
    "  button \"NuGet sources\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed # # package with known vulnerabilities\" {installed-tab}",
    "    tab \"Updates #\" [selected, focused] {updates-tab}",
    "  tabpanel \"Updates #\"",
    "    toolbar \"Bulk actions\" {updates-toolbar}",
    "      button \"Select all\" [not pressed] {select-all-button}",
    "      button \"Update all (#)\" {update-all-button}",
    "    listbox \"Updates\" [multiselectable] {updates-list}",
    "      option \"Dapper # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"FluentValidation # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Humanizer.Core # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Microsoft.Extensions.AI.Abstractions #-preview.# → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Microsoft.Extensions.Configuration.EnvironmentVariables # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Microsoft.Extensions.DependencyInjection.Abstractions # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Microsoft.Extensions.Http # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Microsoft.Extensions.Logging.Abstractions # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Microsoft.Extensions.Options.ConfigurationExtensions # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Newtonsoft.Json # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Polly # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Serilog # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"Serilog.Sinks.Console # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      option \"System.Text.Json # → #\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "  status \"\" {status-live}"
  ]
}
