{
  "state": "main-quicksearch-grouped",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet Packages\"",
    "  checkbox \"Restore After Operations\" [checked]",
    "  checkbox \"Include Pre-Release\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Empty.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unresolved.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All Sources\"",
    "    option \"nuget.org\"",
    "  button \"Manage Package Sources...\" {source-settings}",
    "  button \"Restore Packages\" {restore-button}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [expanded, focused] {search-input}",
    "    button \"Clear Search\"",
    "    button \"Filters\"",
    "    listbox \"Suggestions\" {search-suggestions}",
    "      group \"nuget.org\"",
    "        option \"Serilog\"",
    "        option \"Serilog.Sinks.File\"",
    "        option \"Serilog.Sinks.Console\"",
    "      group \"Fixture source\"",
    "        option \"Serilog.Extensions.Logging\"",
    "        option \"Serilog.Settings.Configuration\"",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "  status \"\" {status-live}"
  ]
}
