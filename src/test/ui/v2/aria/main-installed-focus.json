{
  "state": "main-installed-focus",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet packages\"",
    "  checkbox \"Restore after operations\" [checked]",
    "  checkbox \"Include prerelease\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All sources\"",
    "    option \"nuget.org\"",
    "  button \"NuGet sources\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed # # package with known vulnerabilities\" [selected] {installed-tab}",
    "    tab \"Updates #\" {updates-tab}",
    "  tabpanel \"Installed #\"",
    "    toolbar \"Bulk actions\" {installed-toolbar}",
    "      button \"Select all\" [not pressed] {select-all-button}",
    "      button \"Uninstall selected (#)\" [disabled] {uninstall-selected-button}",
    "    tree \"Installed packages\" [multiselectable] {installed-list}",
    "      treeitem \"Direct packages #\" [expanded, level 1]",
    "      treeitem \"Microsoft.Extensions.DependencyInjection.Abstractions #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Configuration.EnvironmentVariables #\" [level 2, focused]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Options.ConfigurationExtensions #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Logging.Abstractions #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Http #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.AI.Abstractions #-preview.#\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Newtonsoft.Json #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Polly #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Serilog #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Serilog.Sinks.Console #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"System.Text.Json #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"FluentValidation #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Dapper #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Humanizer.Core #\" [level 2]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "  status \"\" {status-live}"
  ]
}
