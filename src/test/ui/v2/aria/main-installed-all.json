{
  "state": "main-installed-all",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet packages\"",
    "  checkbox \"Restore after operations\" [checked]",
    "  checkbox \"Include prerelease\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All sources\"",
    "    option \"nuget.org\"",
    "  button \"NuGet sources\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed # # package with known vulnerabilities\" [selected, focused] {installed-tab}",
    "    tab \"Updates #\" {updates-tab}",
    "  tabpanel \"Installed # # package with known vulnerabilities\"",
    "    toolbar \"Bulk actions\" {installed-toolbar}",
    "      button \"Select all\" [not pressed] {select-all-button}",
    "      button \"Uninstall selected (#)\" [disabled] {uninstall-selected-button}",
    "    status \"\"",
    "    tree \"Installed packages\" [multiselectable] {installed-list}",
    "      treeitem \"app\" [expanded, level 1]",
    "      treeitem \"Catalog.csproj #\" [expanded, level 2]",
    "      treeitem \"Microsoft.EntityFrameworkCore #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.EntityFrameworkCore.Sqlite #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Caching.StackExchangeRedis #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.AspNetCore.Authentication.JwtBearer #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Configuration.EnvironmentVariables #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Swashbuckle.AspNetCore #-preview.#\" [level 3]",
    "      treeitem \"MediatR #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Serilog #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Newtonsoft.Json #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Polly #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"StackExchange.Redis #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Mapster #\" [level 3]",
    "      treeitem \"Gateway.csproj #\" [expanded, level 2]",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "  status \"\" {status-live}"
  ]
}
