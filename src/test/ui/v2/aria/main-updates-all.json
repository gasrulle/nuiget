{
  "state": "main-updates-all",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet packages\"",
    "  checkbox \"Restore after operations\" [checked]",
    "  checkbox \"Include prerelease\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Empty.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unresolved.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All sources\"",
    "    option \"nuget.org\"",
    "  button \"NuGet sources\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Filters\"",
    "  tablist \"Package lists\" {tab-bar}",
    "    tab \"Installed # # package with known vulnerabilities\" {installed-tab}",
    "    tab \"Updates #\" [selected, focused] {updates-tab}",
    "  tabpanel \"Updates #\"",
    "    toolbar \"Bulk actions\" {updates-toolbar}",
    "      button \"Select all\" [not pressed] {select-all-button}",
    "      button \"Update all (#)\" {update-all-button}",
    "    tree \"Updates\" [multiselectable] {updates-list}",
    "      treeitem \"app\" [expanded, level 1]",
    "      treeitem \"Newtonsoft.Json # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Polly # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Serilog # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Serilog.Sinks.Console # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"System.Text.Json # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"tools\" [expanded, level 1]",
    "      treeitem \"Empty.csproj #\" [expanded, level 2]",
    "      treeitem \"No packages installed.\" [level 3]",
    "      treeitem \"Unresolved.csproj #\" [expanded, level 2]",
    "      treeitem \"Newtonsoft.Json # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Unsupported.csproj requires .NET SDK # or newer #\" [expanded, level 2]",
    "      treeitem \"Unsupported project: requires .NET SDK # or newer.\" [level 3]",
    "      treeitem \"Newtonsoft.Json # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Polly # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Serilog # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Utility.csproj #\" [expanded, level 2]",
    "      treeitem \"CsvHelper # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Dapper # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Humanizer.Core # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Configuration.CommandLine # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Configuration.UserSecrets # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Hosting # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Microsoft.Extensions.Hosting.Abstractions # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      treeitem \"Newtonsoft.Json # → #\" [level 3]",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "  status \"\" {status-live}"
  ]
}
