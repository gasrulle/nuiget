    "    option \"Humanizer.Core #\"",
    "    option \"Microsoft.Extensions.Configuration.CommandLine #\"",
    "    option \"Microsoft.Extensions.Configuration.UserSecrets #\"",
    "    option \"Microsoft.Extensions.Hosting #\"",
    "    option \"Microsoft.Extensions.Hosting.Abstractions #\"",
    "    option \"Newtonsoft.Json #\"",
    "    option \"NodaTime #\"",
    "    option \"Serilog #\"",
    "    option \"Spectre.Console #\"",
    "    option \"System.CommandLine #-beta#\"",
    "    option \"YamlDotNet #\"",
    "  separator \"Resize the Installed and Updates sections\" {sash}",
    "  heading \"Updates\"",
