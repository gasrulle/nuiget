{
  "state": "main-browse-details",
  "lines": [
    "main \"\" {nuiget-app}",
    "  heading \"Manage NuGet packages\"",
    "  checkbox \"Restore after operations\" [checked]",
    "  checkbox \"Include prerelease\" [unchecked]",
    "  combobox \"Project\" {project-selector}",
    "    option \"All Projects (#)\"",
    "    option \"Catalog.csproj\"",
    "    option \"Empty.csproj\"",
    "    option \"Gateway.csproj\"",
    "    option \"Unresolved.csproj\"",
    "    option \"Unsupported.csproj\"",
    "    option \"Utility.csproj\"",
    "  combobox \"Package source\" {source-selector}",
    "    option \"All sources\"",
    "    option \"nuget.org\"",
    "  button \"NuGet sources\" {source-settings}",
    "  button \"Refresh\" {refresh-button}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed, @updates or @vulnerable\" [collapsed] {search-input}",
    "    button \"Clear search\"",
    "    button \"Filters\"",
    "  listbox \"Search results for Newtonsoft.Json\" {browse-list}",
    "    option \"Newtonsoft.Json #\" [selected, focused]",
    "      img \"Verified: the package id prefix is reserved by its owner\"",
    "    option × # (live)",
    "  separator \"Resize the package list\" {sash}",
    "  region \"Package details\" {package-details-panel}",
    "    heading \"Newtonsoft.Json\"",
    "    button \"Uninstall\" {uninstall-button}",
    "    combobox \"Version\" {version-selector}",
    "      option \"#\"",
    "      option \"# (installed)\"",
    "      option \"#\"",
    "    button \"Update\" {install-update-button}",
    "    tablist \"Details sections\" {details-tab-bar}",
    "      tab \"Details\" [selected] {details-tab-details}",
    "      tab \"README\" {details-tab-readme}",
    "    tabpanel \"Details\"",
    "      term \"Version\"",
    "      definition \"\"",
    "      term \"Authors\"",
    "      definition \"\"",
    "        img \"Verified: the package id prefix is reserved by its owner\"",
    "      term \"License\"",
    "      definition \"\"",
    "        link \"MIT\"",
    "      term \"Downloads\"",
    "      definition \"\"",
    "      term \"Package size\"",
    "      definition \"\"",
    "      term \"Date published\"",
    "      definition \"\"",
    "      term \"Project URL\"",
    "      definition \"\"",
    "        link \"https://www.newtonsoft.com/json\"",
    "      term \"Report abuse\"",
    "      definition \"\"",
    "        link \"Report this package\"",
    "      region \"Dependencies\"",
    "        heading \"Dependencies\"",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETFramework# #\"",
    "          button \".NETFramework# #\" [collapsed] {section-header-dependencies-.netframework#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "        heading \"net# #\"",
    "          button \"net# #\" [collapsed] {section-header-dependencies-net#}",
    "        heading \".NETStandard# #\"",
    "          button \".NETStandard# #\" [collapsed] {section-header-dependencies-.netstandard#}",
    "  status \"\" {status-live}"
  ]
}
