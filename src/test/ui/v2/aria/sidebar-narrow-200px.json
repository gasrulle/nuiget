{
  "state": "sidebar-narrow-200px",
  "lines": [
    "main \"\" {nuiget-sidebar}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed or @updates\" [collapsed] {sidebar-search-input}",
    "    button \"Filters\"",
    "  heading \"Installed #\"",
    "    button \"Installed #\" [expanded] {section-header-installed}",
    "  listbox \"Installed\" {sidebar-installed-list}",
    "    option \"Dapper #\"",
    "    option \"FluentValidation #\"",
    "    option \"Humanizer.Core #\"",
    "    option \"Microsoft.Extensions.AI.Abstractions #-preview.#\"",
    "    option \"Microsoft.Extensions.Configuration.EnvironmentVariables #\"",
    "    option \"Microsoft.Extensions.DependencyInjection.Abstractions #\"",
    "    option \"Microsoft.Extensions.Http #\"",
    "    option \"Microsoft.Extensions.Logging.Abstractions #\"",
    "    option \"Microsoft.Extensions.Options.ConfigurationExtensions #\"",
    "    option \"NETStandard.Library #\"",
    "    option \"Newtonsoft.Json #\"",
    "    option \"Polly #\"",
    "    option \"Serilog #\"",
    "    option \"Serilog.Sinks.Console #\"",
    "    option \"System.Text.Json #\"",
    "  separator \"Resize the Installed and Updates sections\" {sash}",
    "  heading \"Updates #\"",
    "    button \"Updates #\" [expanded] {section-header-updates}",
    "  button \"Update all (#)\" {sidebar-update-all-button}",
    "  listbox \"Updates\" {sidebar-updates-list}",
    "    option \"Dapper # → #\"",
    "    option \"FluentValidation # → #\"",
    "    option \"Humanizer.Core # → #\"",
    "    option \"Microsoft.Extensions.AI.Abstractions #-preview.# → #\"",
    "    option \"Microsoft.Extensions.Configuration.EnvironmentVariables # → #\"",
    "    option \"Microsoft.Extensions.DependencyInjection.Abstractions # → #\"",
    "    option \"Microsoft.Extensions.Http # → #\"",
    "    option \"Microsoft.Extensions.Logging.Abstractions # → #\"",
    "    option \"Microsoft.Extensions.Options.ConfigurationExtensions # → #\"",
    "    option \"Newtonsoft.Json # → #\"",
    "    option \"Polly # → #\"",
    "    option \"Serilog # → #\"",
    "    option \"Serilog.Sinks.Console # → #\"",
    "    option \"System.Text.Json # → #\"",
    "  status \"\" {status-live}"
  ]
}
