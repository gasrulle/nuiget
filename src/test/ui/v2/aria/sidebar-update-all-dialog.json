{
  "state": "sidebar-update-all-dialog",
  "lines": [
    "main \"\" {nuiget-sidebar}",
    "  search \"\"",
    "    combobox \"Search packages, or filter with @installed or @updates\" [collapsed] {sidebar-search-input}",
    "    button \"Filters\"",
    "  heading \"Installed #\"",
    "    button \"Installed #\" [expanded] {section-header-installed}",
    "  listbox \"Installed\" {sidebar-installed-list}",
    "    option \"Dapper #\"",
    "    option \"FluentValidation #\"",
    "    option \"Humanizer.Core #\"",
    "    option \"Microsoft.Extensions.AI.Abstractions #-preview.#\"",
    "    option \"Microsoft.Extensions.Configuration.EnvironmentVariables #\"",
    "    option \"Microsoft.Extensions.DependencyInjection.Abstractions #\"",
    "    option \"Microsoft.Extensions.Http #\"",
    "    option \"Microsoft.Extensions.Logging.Abstractions #\"",
    "    option \"Microsoft.Extensions.Options.ConfigurationExtensions #\"",
    "    option \"NETStandard.Library #\"",
    "    option \"Newtonsoft.Json #\"",
    "    option \"Polly #\"",
    "    option \"Serilog #\"",
    "    option \"Serilog.Sinks.Console #\"",
    "    option \"System.Text.Json #\"",
    "  separator \"Resize the Installed and Updates sections\" {sash}",
    "  heading \"Updates #\"",
    "    button \"Updates #\" [expanded] {section-header-updates}",
    "  button \"Update all (#)\" {sidebar-update-all-button}",
    "  listbox \"Updates\" {sidebar-updates-list}",
    "    option \"Dapper # → #\"",
    "    option \"FluentValidation # → #\"",
    "    option \"Humanizer.Core # → #\"",
    "    option \"Microsoft.Extensions.AI.Abstractions #-preview.# → #\"",
    "    option \"Microsoft.Extensions.Configuration.EnvironmentVariables # → #\"",
    "    option \"Microsoft.Extensions.DependencyInjection.Abstractions # → #\"",
    "    option \"Microsoft.Extensions.Http # → #\"",
    "    option \"Microsoft.Extensions.Logging.Abstractions # → #\"",
    "    option \"Microsoft.Extensions.Options.ConfigurationExtensions # → #\"",
    "    option \"Newtonsoft.Json # → #\"",
    "    option \"Polly # → #\"",
    "    option \"Serilog # → #\"",
    "    option \"Serilog.Sinks.Console # → #\"",
    "    option \"System.Text.Json # → #\"",
    "  status \"\" {status-live}",
    "alertdialog \"Update # packages?\" {confirm-dialog}",
    "  heading \"Update # packages?\"",
    "  list \"\"",
    "    listitem \"Dapper: # → #\"",
    "    listitem \"FluentValidation: # → #\"",
    "    listitem \"Humanizer.Core: # → #\"",
    "    listitem \"Microsoft.Extensions.AI.Abstractions: #-preview.# → #\"",
    "    listitem \"Microsoft.Extensions.Configuration.EnvironmentVariables: # → #\"",
    "    listitem \"Microsoft.Extensions.DependencyInjection.Abstractions: # → #\"",
    "    listitem \"Microsoft.Extensions.Http: # → #\"",
    "    listitem \"Microsoft.Extensions.Logging.Abstractions: # → #\"",
    "    listitem \"Microsoft.Extensions.Options.ConfigurationExtensions: # → #\"",
    "    listitem \"Newtonsoft.Json: # → #\"",
    "    listitem \"Polly: # → #\"",
    "    listitem \"Serilog: # → #\"",
    "    listitem \"Serilog.Sinks.Console: # → #\"",
    "    listitem \"System.Text.Json: # → #\"",
    "  button \"Cancel\" [focused] {confirm-dialog-cancel}",
    "  button \"Update\" {confirm-dialog-confirm}"
  ]
}
