# Only dist/*.js, dist/*.css, resources/, package.json, README.md, CHANGELOG.md and LICENSE ship in the VSIX.
# `npm run check:vsix` (scripts/check-vsix-contents.mjs) fails when anything else would ship.

# Sources (including src/_wip/**), tests and build output that is not the bundle
src/**
out/**
coverage/**
benchmarks/**
scripts/**
**/*.map
**/*.ts
dist/**/*.meta.json
!dist/**/*.js

# Tooling and editor configuration
.vscode/**
.vscode-test/**
.vscode-test.mjs
.nvmrc
.editorconfig
.gitignore
.github/**
esbuild.mjs
eslint.config.mjs
vitest.config.mts
**/tsconfig.json
**/tsconfig.*.json
node_modules/**
package-lock.json

# Claude Code configuration
.claude/**
CLAUDE.md
.mcp.json
# Owner settings patches of the UX plan (applied by the owner, never shipped)
patches/**
# CI captures a session downloads (RUN-ux.md §4): gitignored, never shipped
captures/**

# Documentation that is not shown on the Marketplace page
ARCHITECTURE.md
docs/**

# Built packages and recordings
*.vsix
*.gif
*.mp4
